{
  "name": "YAAWC",
  "build": { "dockerfile": "Dockerfile" },
  // Ignored when cloning into a named volume; VS Code mounts the clone volume at /workspaces itself.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/YAAWC,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/YAAWC",
  "runArgs": ["--init", "--cap-add=SYS_ADMIN", "--network=host"],
  "mounts": [
    "source=yaawc-data,target=/home/yaawc/data,type=volume",
    "source=yaawc-uploads,target=/home/yaawc/uploads,type=volume",
    "source=yaawc-deep-research,target=/home/yaawc/storage/deep_research,type=volume",
    "source=yaawc-user-state,target=/home/node/.persist,type=volume"
  ],
  "containerEnv": {
    "SEARXNG_API_URL": "${localEnv:SEARXNG_API_SCHEME:https}://${localEnv:SEARXNG_API_HOST:searxng.int.bit-shift.com}",
    "DATA_DIR": "/home/yaawc/data"
  },
  "shutdownAction": "stopContainer",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "npm ci --fetch-timeout=600000 && npx playwright install chromium || true",
  // Ensure persisted config dirs exist behind the volume mount; seed each tool's config on first use, never overwriting an existing one.
  "postStartCommand": "mkdir -p /home/node/.persist/opencode-config /home/node/.persist/opencode-data /home/node/.persist/herdr; [ -f /home/node/.persist/opencode-config/opencode.json ] || printf '%s\\n' '{ \"$schema\": \"https://opencode.ai/config.json\", \"lsp\": true }' > /home/node/.persist/opencode-config/opencode.json; [ -f /home/node/.persist/herdr/config.toml ] || printf '%s\\n' '[terminal]' 'default_shell = \"/usr/bin/zsh\"' 'new_cwd = \"/workspaces/YAAWC\"' > /home/node/.persist/herdr/config.toml",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ],
        "files.watcherExclude": {
          "**/.next/**": true,
          "**/node_modules/**": true
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteEnv": {
    "LANGSMITH_ENDPOINT": "${localEnv:LANGSMITH_ENDPOINT}",
    "LANGSMITH_API_KEY": "${localEnv:LANGSMITH_API_KEY}",
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "${localEnv:XAUTHORITY}",
    "CCALT_ANTHROPIC_BASE_URL": "${localEnv:CCALT_ANTHROPIC_BASE_URL}",
    "CCALT_ANTHROPIC_AUTH_TOKEN": "${localEnv:CCALT_ANTHROPIC_AUTH_TOKEN}",
    "CCALT_ANTHROPIC_MODEL": "${localEnv:CCALT_ANTHROPIC_MODEL}",
    "CCALT_ANTHROPIC_DEFAULT_OPUS_MODEL": "${localEnv:CCALT_ANTHROPIC_DEFAULT_OPUS_MODEL}",
    "CCALT_ANTHROPIC_DEFAULT_SONNET_MODEL": "${localEnv:CCALT_ANTHROPIC_DEFAULT_SONNET_MODEL}",
    "CCALT_ANTHROPIC_DEFAULT_HAIKU_MODEL": "${localEnv:CCALT_ANTHROPIC_DEFAULT_HAIKU_MODEL}",
    "CCALT_CLAUDE_CODE_SUBAGENT_MODEL": "${localEnv:CCALT_CLAUDE_CODE_SUBAGENT_MODEL}",
    "CCALT_CLAUDE_CODE_EFFORT_LEVEL": "${localEnv:CCALT_CLAUDE_CODE_EFFORT_LEVEL}"
  }
}
